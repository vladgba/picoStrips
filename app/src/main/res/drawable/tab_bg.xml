<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_selected="true">
                <layer-list>
                    <item android:gravity="bottom|center_horizontal" android:height="3dp" android:width="48dp">
                        <shape><solid android:color="@color/accent" /><corners android:radius="2dp" /></shape>
                    </item>
                </layer-list>
            </item>
            <item><color android:color="@android:color/transparent" /></item>
        </selector>
    </item>
</ripple>
